# Persistent directory. Mount a volume here when deploying with Docker.
DATA_DIR=./data
# true on HTTPS production; false only for local HTTP testing.
COOKIE_SECURE=true

# Optional canonical HTTPS origin, e.g. https://solo-pr.ru
# SITE_ORIGIN=https://your-domain.example

# --- Integrations (secrets only via env / secret store) ---
# VORONKA_WEBHOOK_URL=https://voronka.example/hooks/solo-pr
# VORONKA_WEBHOOK_SECRET=
# VORONKA_INBOUND_SECRET=
# VORONKA_BASE_URL=https://voronka.example
# VORONKA_ENABLED=true

# LMS_BASE_URL=https://lms.example
# LMS_API_SECRET=
# LMS_ENABLED=true

# OIDC / Keycloak for commercial center SSO
# OIDC_ISSUER=https://keycloak.example/realms/solo
# OIDC_CLIENT_ID=solo_pr
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://solo-pr.ru/api/portal/auth/oidc/callback
# OIDC_ENABLED=false

# Documents (RU volume by default; optional external HTTPS allowlist)
# DOCUMENT_URL_ALLOWLIST=files.example.ru,storage.yandexcloud.net
# DOCUMENT_SIGNING_SECRET=

# 152-FZ hosting disclosure (shown in admin integrations / ops docs)
PD_HOST_COUNTRY=RU
# PD_HOST_PROVIDER=Selectel|Yandex Cloud|VK Cloud|Timeweb
# PD_HOST_REGION=

# Sites demo only — never enable on production VPS
# SITES_ADMIN_ELEVATE=false

# Outbox worker / cron (lead.created retries independent of new traffic)
# OUTBOX_POLL_MS=15000
# OUTBOX_WORKER=true
# CRON_SECRET=

# Portal hosts (docs/PORTALS.md). SITE_ORIGIN stays the public apex; cms.* POSTs are allowlisted in code.
# SITE_ORIGIN=https://solo-pr.ru
